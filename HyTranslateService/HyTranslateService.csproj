<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<Title>HyTranslateService</Title>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Exe</OutputType>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<VersionPrefix>1.0.0</VersionPrefix>
		<RootNamespace>HyTranslateService</RootNamespace>
		<IlcInstructionSet>avx2</IlcInstructionSet>
		<RuntimeIdentifiers>win-x64;win-arm64;osx-arm64;linux-x64;linux-arm64;linux-musl-x64</RuntimeIdentifiers>
		<PublishAot>false</PublishAot>
		<PublishTrimmed>false</PublishTrimmed>
		<SelfContained>false</SelfContained>
		<PublishSingleFile>false</PublishSingleFile>
		<InvariantGlobalization>false</InvariantGlobalization>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
		<PackAsTool>true</PackAsTool>
		<PackageType>McpServer</PackageType>
		<PackageReadmeFile></PackageReadmeFile>
		<PackageId>HyTranslateService.Mcp</PackageId>
		<PackageVersion>1.0.0</PackageVersion>
		<PackageTags>AI;MCP;server;translation;hunyuan;hymt2;gguf</PackageTags>
		<Description>基于 HyMT2Sharp 的本地 Hy-MT2 翻译 MCP 服务器，内置 WebUI，支持多模型（内存中同一时刻只常驻 1 个）、长文本自动拆段、流式输出与随时终止。</Description>
		<ApplicationIcon>Logo.ico</ApplicationIcon>
		<Authors>归朴工作室</Authors>
		<Copyright>归朴工作室</Copyright>
	</PropertyGroup>

	<ItemGroup>
		<!-- Microsoft.Extensions.Hosting 由 Microsoft.NET.Sdk.Web 自带，无需显式引用（NU1510） -->
		<PackageReference Include="ModelContextProtocol" Version="2.2.0" />
		<PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\HyMT2Sharp\HyMT2Sharp.csproj" />
	</ItemGroup>
	
</Project>
